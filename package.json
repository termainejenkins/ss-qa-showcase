{
  "name": "ss-qa-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Playwright checks for the public Sentient Solutions website. Tested in CI.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
